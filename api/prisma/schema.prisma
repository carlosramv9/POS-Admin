// ============= Orders =============
enum OrderStatus {
  PENDING
  LAYAWAY
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentConcept {
  SALE
  DOWN_PAYMENT
  LAYAWAY_DEPOSIT
  BALANCE_PAYMENT
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
}

enum KitchenOrderStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  READY
  REJECTED
  DELIVERED
}

enum OrderItemType {
  PRODUCT
  SERVICE
}

enum OrderOrigin {
  RETAIL_POS
  RESTAURANT_COMANDA
  DELIVERY
  KIOSK
  ONLINE
}

// ============= Restaurant: Dining Areas =============

model DiningArea {
  id           String  @id @default(uuid())
  tenantId     String
  branchId     String
  name         String
  description  String?
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("DiningAreaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("DiningAreaUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  tables RestaurantTable[]

  @@unique([branchId, name])
  @@index([tenantId, branchId, isActive])
  @@map("dining_areas")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  BLOCKED
}

enum DiningOrderStatus {
  OPEN
  // Kitchen flow (module KITCHEN enabled)
  SENT_TO_KITCHEN
  IN_PREPARATION
  READY
  DELIVERED
  // No-kitchen flow (module KITCHEN disabled)
  READY_FOR_PAYMENT
  // Terminal
  PAID
  CLOSED
  CANCELLED
}

enum DiningServiceType {
  DINE_IN
  COUNTER
}

enum RestaurantServiceMode {
  TABLE_SERVICE
  COUNTER_SERVICE
  HYBRID
}

// Per-branch waiter command visibility. Controls whether an operator (waiter)
// sees every active DiningOrder or only their own. Tables/Kitchen/Cashier are
// NEVER filtered by this — only DiningOrder listing for scope='own'. The filter
// itself is NOT implemented yet (see DiningOrdersService.resolveVisibilityWhere):
// today all modes behave like SHARED. Default SHARED preserves current behavior.
enum RestaurantVisibilityMode {
  SHARED
  OWN_ONLY
  OWN_WITH_SUPERVISOR
}

model RestaurantTable {
  id           String      @id @default(uuid())
  tenantId     String
  branchId     String
  areaId       String
  name         String
  capacity     Int         @default(4)
  displayOrder Int         @default(0)
  isActive     Boolean     @default(true)
  status       TableStatus @default(AVAILABLE)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  area         DiningArea    @relation(fields: [areaId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("RestaurantTableCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?         @relation("RestaurantTableUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  diningOrders DiningOrder[]

  @@unique([branchId, name])
  @@index([tenantId, branchId, areaId, isActive])
  @@map("restaurant_tables")
}

model DiningOrder {
  id          String            @id @default(uuid())
  tenantId    String
  branchId    String
  tableId     String?
  waiterId    String
  serviceType DiningServiceType @default(DINE_IN) @map("service_type")
  reference   String?
  status      DiningOrderStatus @default(OPEN)
  openedAt    DateTime          @default(now())
  closedAt    DateTime?

  // Financial bridge: set when the dining order is checked out and converted
  // into a financial Order. Nullable (open/operational orders have none) and
  // unique (a dining order maps to at most one Order). No lifecycle logic yet.
  orderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table         RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: Cascade)
  waiter        Employee          @relation("DiningOrderWaiter", fields: [waiterId], references: [id])
  order         Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items         DiningOrderItem[]
  kitchenRounds KitchenRound[]

  @@index([tenantId, branchId, status])
  @@index([tableId, status])
  @@map("dining_orders")
}

enum KitchenRoundStatus {
  SENT
  IN_PREPARATION
  DONE
}

model KitchenRound {
  id          String             @id @default(uuid())
  orderId     String             @map("order_id")
  roundNumber Int                @map("round_number")
  sentAt      DateTime           @map("sent_at")
  status      KitchenRoundStatus @default(SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order DiningOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items DiningOrderItem[]

  @@index([orderId])
  @@map("kitchen_rounds")
}

model DiningOrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String?
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int     @default(1)
  notes       String?

  // Momento en que el ítem se envió a cocina/caja. NULL = pendiente de envío
  // (ronda en captura). Permite rondas múltiples sobre la misma cuenta sin
  // duplicar DiningOrder y sin re-enviar lo ya preparado.
  sentToKitchenAt DateTime? @map("sent_to_kitchen_at")

  // FK a la ronda de cocina que lo envió. NULL para ítems pre-migración o cuando
  // kitchen está deshabilitado.
  kitchenRoundId String? @map("kitchen_round_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        DiningOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kitchenRound KitchenRound? @relation(fields: [kitchenRoundId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("dining_order_items")
}

model Order {
  id             String        @id @default(uuid())
  tenantId       String
  orderNumber    String
  customerId     String?
  addressId      String?
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  shippingCost   Decimal       @default(0) @db.Decimal(10, 2)
  discount       Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  notes          String?
  tableNumber    String?
  employeeNumber String?
  guestCount     Int?

  couponId   String?
  couponCode String?

  branchId String?

  exchangeRateUsed      Decimal?        @db.Decimal(10, 4)
  serviceQuoteId        String?
  deliveryStatus        DeliveryStatus?
  estimatedDeliveryDate DateTime?
  deliveredAt           DateTime?

  orderOrigin             OrderOrigin?
  kitchenStatus           KitchenOrderStatus?
  kitchenStartedAt        DateTime?
  kitchenReadyAt          DateTime?
  kitchenPausedAt         DateTime?
  kitchenRejectedAt       DateTime?
  kitchenRejectedById     String?
  kitchenRejectionComment String?

  cancelledAt        DateTime?
  cancellationReason String?
  cancelledById      String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer?          @relation(fields: [customerId], references: [id])
  shippingAddress   CustomerAddress?   @relation(fields: [addressId], references: [id])
  coupon            Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  branch            Branch?            @relation(fields: [branchId], references: [id])
  serviceQuote      ServiceQuote?      @relation(fields: [serviceQuoteId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  payments          Payment[]
  accountReceivable AccountReceivable?
  refunds           OrderRefund[]
  diningOrder       DiningOrder?
  createdBy         User?              @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy         User?              @relation("OrderUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  cancelledBy       User?              @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@unique([tenantId, orderNumber])
  @@map("orders")
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  itemType    OrderItemType @default(PRODUCT)
  productId   String?
  // Variante vendida. Nullable durante la fase expand: las líneas anteriores a
  // la migración apuntan a la default por backfill, y las nuevas la traen
  // siempre. `SetNull` para que borrar una variante no borre el historial.
  variantId   String?
  serviceId   String?
  name        String
  description String?
  sku         String?
  quantity    Int
  price       Decimal       @db.Decimal(10, 2)
  discount    Decimal       @default(0) @db.Decimal(10, 2)
  tax         Decimal       @default(0) @db.Decimal(10, 2)
  subtotal    Decimal       @db.Decimal(10, 2)
  total       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?          @relation(fields: [productId], references: [id])
  variant     ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  service     Service?          @relation(fields: [serviceId], references: [id])
  refundItems OrderRefundItem[]

  @@map("order_items")
}

// ============= Branches =============
enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  CLOSED
}

model Branch {
  id        String       @id @default(uuid())
  tenantId  String
  name      String
  code      String
  address   String?
  city      String?
  state     String?
  zipCode   String?
  phone     String?
  email     String?
  managerId String?
  isMain    Boolean      @default(false)
  status    BranchStatus @default(ACTIVE)
  settings  Json?

  // Waiter command visibility for this branch. Default SHARED = current behavior
  // (everyone sees every active order). Persisted infra for a future filter; not
  // enforced yet. See DiningOrdersService.resolveVisibilityWhere.
  restaurantVisibilityMode RestaurantVisibilityMode @default(SHARED) @map("restaurant_visibility_mode")
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager            User?               @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  memberships        BranchMembership[]
  inventory          BranchInventory[]
  cashRegisters      CashRegister[]
  orders             Order[]
  inventoryMovements InventoryMovement[]
  cashSessions       CashSession[]
  purchaseOrders     PurchaseOrder[]
  supplies           Supply[]            @relation("BranchSupplies")
  supplyMovements    SupplyMovement[]    @relation("BranchSupplyMovements")
  printerConfigs     PrinterConfig[]
  devices            Device[]
  employeeBranches   EmployeeBranch[]
  diningAreas        DiningArea[]
  restaurantTables   RestaurantTable[]
  diningOrders       DiningOrder[]

  usersLastSelected User[] @relation("UserLastBranch")

  aiUsageEvents AiUsageEvent[]

  @@unique([tenantId, code])
  @@map("branches")
}

model BranchMembership {
  branchId   String
  userId     String
  isPrimary  Boolean  @default(false)
  assignedAt DateTime @default(now())

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([branchId, userId])
  @@map("branch_memberships")
}

// Single source of truth for the commercial data of a sellable line: stock,
// cost and price, per branch and per variant.
//
// Keyed [branchId, variantId]: one row per variant per branch. The older
// [branchId, productId] key could only ever hold one row per product per branch,
// which made stocking two variants of the same product impossible.
//
// Expand phase (see the add_variant_inventory / variant_inventory_primary_key
// migrations): every row was backfilled to its product's default variant. The
// legacy commercial columns on Product and ProductVariant are deliberately still
// in place and still written to, so this change stays revertible; the contract
// phase drops them once all reads come from here.
model BranchInventory {
  branchId      String
  // Denormalized parent pointer: no longer unique per branch (a product may hold
  // one row per variant), kept indexed for product-keyed lookups.
  productId     String
  variantId     String
  stock         Int      @default(0)
  // Effective commercial values for this branch+variant. Nullable during expand
  // so a missing backfill is visible rather than silently reading as 0.
  cost          Decimal? @db.Decimal(10, 2)
  price         Decimal? @db.Decimal(10, 2)
  comparePrice  Decimal? @db.Decimal(10, 2)
  lastCost      Decimal? @db.Decimal(10, 2)
  avgCost       Decimal? @db.Decimal(10, 2)
  // Branch-level reorder point (a legitimately per-branch number, unlike the
  // per-variant trackInventory policy flag).
  lowStockAlert Int      @default(5)
  updatedAt     DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([branchId, variantId])
  @@index([branchId, productId])
  @@map("branch_inventory")
}

// ============= Payments =============
model Payment {
  id                     String         @id @default(uuid())
  orderId                String
  paymentMethod          String
  transactionId          String?
  currency               String         @default("MXN")
  amount                 Decimal        @db.Decimal(10, 2)
  amountReceived         Decimal?       @db.Decimal(10, 2)
  changeGiven            Decimal?       @db.Decimal(10, 2)
  changeCurrency         String?
  exchangeRateUsed       Decimal?       @db.Decimal(10, 4)
  amountOriginalCurrency Decimal?       @db.Decimal(10, 2)
  amountMxnEquivalent    Decimal?       @db.Decimal(10, 2)
  status                 PaymentStatus  @default(PENDING)
  paymentConcept         PaymentConcept @default(SALE)
  gatewayResponse        Json?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  createdById String?
  createdBy   User?   @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// ============= Order Refunds =============
model OrderRefund {
  id               String   @id @default(uuid())
  tenantId         String
  orderId          String
  amount           Decimal  @db.Decimal(10, 2)
  currency         String   @default("MXN")
  refundMethod     String
  originalMethod   String?
  reason           String
  restoreInventory Boolean  @default(false)
  windowOverride   Boolean  @default(false)
  notes            String?
  cashMovementId   String?
  createdById      String?
  createdAt        DateTime @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order     Order             @relation(fields: [orderId], references: [id])
  createdBy User?             @relation("RefundCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items     OrderRefundItem[]

  @@index([tenantId, orderId])
  @@map("order_refunds")
}

// Per-line breakdown of an item-level refund. Its presence on a refund is what
// drives inventory restoration; money-only refunds carry no items. Cumulative
// quantity per orderItem (summed across refunds) must never exceed the quantity
// originally sold — that invariant is what stops a line being restored twice.
model OrderRefundItem {
  id          String   @id @default(uuid())
  refundId    String
  orderItemId String
  productId   String?
  quantity    Int
  createdAt   DateTime @default(now())

  refund    OrderRefund @relation(fields: [refundId], references: [id], onDelete: Cascade)
  orderItem OrderItem   @relation(fields: [orderItemId], references: [id])

  @@index([orderItemId])
  @@index([refundId])
  @@map("order_refund_items")
}

// ============= Accounts Receivable (CxC) =============
enum AccountReceivableStatus {
  PENDIENTE
  PARCIAL
  PAGADO
  VENCIDO
}

model AccountReceivable {
  id          String                  @id @default(uuid())
  tenantId    String
  orderId     String                  @unique
  customerId  String?
  totalAmount Decimal                 @db.Decimal(10, 2)
  balance     Decimal                 @db.Decimal(10, 2)
  status      AccountReceivableStatus @default(PENDIENTE)
  dueDate     DateTime
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  tenant   Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order    Order                      @relation(fields: [orderId], references: [id])
  customer Customer?                  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payments AccountReceivablePayment[]

  @@map("account_receivables")
}

model AccountReceivablePayment {
  id                  String   @id @default(uuid())
  accountReceivableId String
  amount              Decimal  @db.Decimal(10, 2)
  paymentDate         DateTime @default(now())
  paymentMethod       String
  reference           String?
  notes               String?
  createdAt           DateTime @default(now())

  accountReceivable AccountReceivable @relation(fields: [accountReceivableId], references: [id], onDelete: Cascade)

  @@map("account_receivable_payments")
}

// ============= Accounts Payable (CxP) =============

enum AccountPayableStatus {
  PENDIENTE
  PARCIAL
  PAGADO
}

enum SupplierPaymentMethod {
  CASH
  TRANSFER
  CARD
}

/// Estados del ciclo de caja. EN_ARQUEO y PENDIENTE_REVISION permiten el corte
/// parcial: contar sin cerrar, y dejar un cierre esperando autorización, sin que
/// la caja vuelva a operar (docs/AUDITORIA-CAJA.md, CASH-011).
enum CashSessionStatus {
  ABIERTA
  EN_ARQUEO
  PENDIENTE_REVISION
  CERRADA
}

/// PARCIAL: arqueo de control con la caja abierta (cambio de turno, recuento
/// tras diferencia). FINAL: el que acompaña al cierre.
enum CashCountType {
  PARCIAL
  FINAL
}

enum CashMovementType {
  SALE
  CXC_PAYMENT
  SUPPLIER_PAYMENT
  INCOME
  EXPENSE
  /// Retiro de efectivo del cajón. Tipo de movimiento y no tabla aparte, para
  /// conservar un libro mayor único (docs/AUDITORIA-CAJA.md §7.1, CASH-005).
  WITHDRAWAL
  /// Devolución al cliente. Se tipaba EXPENSE y el corte la mostraba como
  /// "egreso manual", ocultando su origen (CASH-013).
  REFUND
}

/// Caja física. Vive por encima de las sesiones: la misma gaveta acumula N
/// sesiones a lo largo del tiempo. Sin esta entidad no podía haber más de una
/// caja por sucursal (docs/AUDITORIA-CAJA.md §7.1, matriz #1).
model CashRegister {
  id        String   @id @default(uuid())
  tenantId  String
  branchId  String?
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  sessions CashSession[]

  @@unique([tenantId, branchId, name])
  @@index([tenantId, branchId, isActive])
  @@map("cash_registers")
}

model CashSession {
  id                     String            @id @default(uuid())
  tenantId               String
  branchId               String?
  /// Caja física a la que pertenece la sesión.
  cashRegisterId         String?
  status                 CashSessionStatus @default(ABIERTA)
  exchangeRateUsdMxn     Decimal           @default(1) @db.Decimal(10, 4)
  openingAmount          Decimal           @db.Decimal(10, 2)
  openingAmountUsd       Decimal           @default(0) @db.Decimal(10, 2)
  /// Efectivo esperado calculado al cerrar (no lo contado: eso es `cashCounted`).
  expectedAmount         Decimal?          @db.Decimal(10, 2)
  cashCounted            Decimal?          @db.Decimal(10, 2)
  cashCountedUsd         Decimal?          @db.Decimal(10, 2)
  difference             Decimal?          @db.Decimal(10, 2)
  differenceUsd          Decimal?          @db.Decimal(10, 2)
  /// Justificación de la diferencia del cierre. Obligatoria cuando supera el
  /// umbral del tenant — antes una caja podía cerrar descuadrada sin explicación
  /// (docs/AUDITORIA-CAJA.md, CASH-006).
  differenceReason       String?
  /// Efectivo que permanece en el cajón tras el retiro del cierre. Encadena con
  /// la apertura siguiente: `fondo restante = contado - retiro` (CASH-005).
  remainingFund          Decimal?          @db.Decimal(10, 2)
  remainingFundUsd       Decimal?          @db.Decimal(10, 2)
  notes                  String?
  openedById             String?
  closedById             String?
  authorizedById         String?
  /// Empleado que autorizó por PIN desde el POS. Es un `Employee` y no un
  /// `User` porque un operador con PIN no necesita cuenta del sistema; para la
  /// autorización con contraseña del Admin Web se sigue usando `authorizedById`.
  authorizedByEmployeeId String?           @map("authorized_by_employee_id")
  openedAt               DateTime          @default(now())
  closedAt               DateTime?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  tenant               Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch               Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  openedBy             User?          @relation("CashSessionOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  closedBy             User?          @relation("CashSessionClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  authorizedBy         User?          @relation("CashSessionAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)
  cashRegister         CashRegister?  @relation(fields: [cashRegisterId], references: [id], onDelete: Restrict)
  authorizedByEmployee Employee?      @relation("CashSessionAuthorizedByEmployee", fields: [authorizedByEmployeeId], references: [id], onDelete: SetNull)
  movements            CashMovement[]
  counts               CashCount[]

  @@map("cash_sessions")
}

/// Arqueo físico. Entidad y no columnas de la sesión porque el negocio puede
/// requerir varios en un mismo día — corte por turno, recuento tras una
/// diferencia — y cada uno necesita su propio responsable, momento y resultado
/// (docs/AUDITORIA-CAJA.md §7.1, CASH-006).
model CashCount {
  id             String        @id @default(uuid())
  tenantId       String
  cashSessionId  String
  type           CashCountType @default(PARCIAL)
  /// Efectivo contado físicamente.
  countedMxn     Decimal       @db.Decimal(10, 2)
  countedUsd     Decimal       @default(0) @db.Decimal(10, 2)
  /// Esperado al momento del conteo: se congela aquí porque sigue cambiando
  /// mientras la caja opera, y un arqueo debe poder releerse tal cual se hizo.
  expectedMxn    Decimal       @db.Decimal(10, 2)
  expectedUsd    Decimal       @default(0) @db.Decimal(10, 2)
  differenceMxn  Decimal       @db.Decimal(10, 2)
  differenceUsd  Decimal       @default(0) @db.Decimal(10, 2)
  /// Desglose opcional por denominación: `{ "1000": 2, "500": 3, ... }`.
  denominations  Json?
  reason         String?
  countedById    String?
  authorizedById String?
  createdAt      DateTime      @default(now())

  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashSession  CashSession @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  countedBy    User?       @relation("CashCountCountedBy", fields: [countedById], references: [id], onDelete: SetNull)
  authorizedBy User?       @relation("CashCountAuthorizedBy", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@index([tenantId, cashSessionId, createdAt])
  @@map("cash_counts")
}

model AccountPayable {
  id              String               @id @default(uuid())
  tenantId        String
  purchaseOrderId String               @unique
  supplierId      String
  totalAmount     Decimal              @db.Decimal(10, 2)
  balance         Decimal              @db.Decimal(10, 2)
  status          AccountPayableStatus @default(PENDIENTE)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder     @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  payments      SupplierPayment[]

  @@map("accounts_payable")
}

model SupplierPayment {
  id               String                @id @default(uuid())
  accountPayableId String
  amount           Decimal               @db.Decimal(10, 2)
  paymentMethod    SupplierPaymentMethod
  paymentDate      DateTime              @default(now())
  reference        String?
  notes            String?
  createdById      String?
  createdAt        DateTime              @default(now())

  accountPayable AccountPayable @relation(fields: [accountPayableId], references: [id], onDelete: Cascade)
  createdBy      User?          @relation("SupplierPaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cashMovements  CashMovement[]

  @@map("supplier_payments")
}

model CashMovement {
  id                     String           @id @default(uuid())
  tenantId               String
  /// Obligatorio: todo movimiento pertenece a una sesión. Antes era opcional y
  /// los cobros de CxC, pagos a proveedor y movimientos manuales sin caja
  /// abierta se guardaban huérfanos — dinero real que no aparecía en ningún
  /// corte. Ver docs/AUDITORIA-CAJA.md (CASH-001).
  cashSessionId          String
  type                   CashMovementType
  currency               String           @default("MXN")
  amount                 Decimal          @db.Decimal(10, 2)
  exchangeRateUsed       Decimal?         @db.Decimal(10, 4)
  amountOriginalCurrency Decimal?         @db.Decimal(10, 2)
  amountMxnEquivalent    Decimal?         @db.Decimal(10, 2)
  paymentMethod          String
  supplierPaymentId      String?          @unique
  referenceId            String?
  referenceType          String?
  notes                  String?
  createdById            String?
  createdAt              DateTime         @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, no SetNull: borrar una sesión dejaba sus movimientos huérfanos en
  // silencio en vez de impedir la operación (CASH-013).
  cashSession     CashSession      @relation(fields: [cashSessionId], references: [id], onDelete: Restrict)
  supplierPayment SupplierPayment? @relation(fields: [supplierPaymentId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("CashMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // El corte agrega por sesión y tipo; sin índice la consulta escanea la tabla.
  @@index([tenantId, cashSessionId, type])
  @@map("cash_movements")
}

// ============= Audit Log (critical operations) =============

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  action     String // ORDER_CANCEL, ORDER_RETURN, INVENTORY_ADJUST, PRICE_CHANGE
  entityType String // Order, Product, ...
  entityId   String
  before     Json?
  after      Json?
  reason     String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action, createdAt])
  @@map("audit_logs")
}

// ============= Permissions & Roles (tenant-scoped) =============

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  module      String
  action      String

  rolePermissions RolePermission[]
  userGrants      UserPermissionGrant[]

  @@map("permissions")
}

model Role {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean @default(false)
  color       String? @default("#6366f1")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]
  dashboardRoles  DashboardRole[]
  widgetRoles     WidgetRole[]
  employees       Employee[]           @relation("EmployeeRole")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  userId     String
  roleId     String
  tenantId   String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_role_assignments")
}

model UserPermissionGrant {
  userId       String
  permissionId String
  tenantId     String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permission_grants")
}

// ============= Dynamic Dashboards — Enums =============

enum WidgetType {
  COUNTER
  BAR_CHART
  LINE_CHART
  AREA_CHART
  PIE_CHART
  DONUT_CHART
  TABLE
  RANKING
  TIMELINE
  HEATMAP
  FUNNEL
  GAUGE
  TEXT_CARD
}

// ============= Capital Humano - Employees =============

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ON_LEAVE
}

enum ContractType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
  TEMPORARY
}

model Employee {
  id             String         @id @default(uuid())
  tenantId       String
  employeeNumber String
  firstName      String
  lastName       String
  email          String
  phone          String?
  birthDate      DateTime?
  curp           String?
  rfc            String?
  department     String?
  position       String?
  contractType   ContractType   @default(FULL_TIME)
  hireDate       DateTime       @default(now())
  salary         Decimal?       @db.Decimal(12, 2)
  status         EmployeeStatus @default(ACTIVE)
  notes          String?

  // Operative PIN login (comandera). Deterministic hash (sha256 + pepper) so it
  // can be looked up + kept unique per tenant. `roleId` sources the operator's
  // permissions from the RBAC roles table without needing a User account.
  pinHash String? @map("pin_hash")
  roleId  String? @map("role_id")

  // Cuenta de back-office de esta misma persona, si la tiene. Opcional a
  // propósito: la mayoría del personal opera solo con PIN y nunca necesita
  // entrar al panel. Sin este vínculo, empleado y usuario eran dos altas
  // manuales sin relación, y sus datos podían divergir sin que nadie lo notara
  // (mismo patrón que `hr.employee.user_id` en Odoo).
  userId String? @map("user_id")

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                 Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                   Role?            @relation("EmployeeRole", fields: [roleId], references: [id], onDelete: SetNull)
  branches               EmployeeBranch[]
  diningOrders           DiningOrder[]    @relation("DiningOrderWaiter")
  cashSessionsAuthorized CashSession[]    @relation("CashSessionAuthorizedByEmployee")
  createdBy              User?            @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy              User?            @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  user                   User?            @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, email])
  @@unique([tenantId, pinHash])
  // Una cuenta no puede estar vinculada a dos empleados del mismo tenant.
  @@unique([tenantId, userId])
  @@map("employees")
}

model EmployeeBranch {
  employeeId String   @map("employee_id")
  branchId   String   @map("branch_id")
  isPrimary  Boolean  @default(false) @map("is_primary")
  assignedAt DateTime @default(now()) @map("assigned_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([employeeId, branchId])
  @@map("employee_branches")
}

// ============= Work Orders =============

enum WorkOrderStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

model WorkOrder {
  id          String          @id @default(uuid())
  tenantId    String
  orderNumber String
  customerId  String
  serviceId   String?
  description String
  status      WorkOrderStatus @default(PENDING)
  dueDate     DateTime?
  notes       String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer              @relation(fields: [customerId], references: [id])
  service     Service?              @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy   User?                 @relation("WorkOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignments WorkOrderAssignment[]
  quoteLink   WorkOrderQuote?

  @@unique([tenantId, orderNumber])
  @@map("work_orders")
}

model WorkOrderAssignment {
  id          String    @id @default(uuid())
  workOrderId String
  userId      String
  startedAt   DateTime?
  finishedAt  DateTime?
  notes       String?
  createdAt   DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation("WorkOrderAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@map("work_order_assignments")
}

model WorkOrderQuote {
  workOrderId    String @unique
  serviceQuoteId String

  workOrder    WorkOrder    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  serviceQuote ServiceQuote @relation(fields: [serviceQuoteId], references: [id], onDelete: Cascade)

  @@id([workOrderId, serviceQuoteId])
  @@map("work_order_quotes")
}

// ============= Dynamic Dashboards =============

model Dashboard {
  id          String  @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  isDefault   Boolean @default(false)
  isActive    Boolean @default(true)
  icon        String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboardWidgets DashboardWidget[]
  layouts          DashboardLayout[]
  roles            DashboardRole[]
  createdBy        User?             @relation("DashboardCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User?             @relation("DashboardUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, isActive])
  @@map("dashboards")
}

model DashboardLayout {
  id          String @id @default(uuid())
  dashboardId String
  breakpoint  String // "lg" | "md" | "sm" | "xs"
  layout      Json // GridItem[] — { i, x, y, w, h, minW?, minH?, static? }

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, breakpoint])
  @@map("dashboard_layouts")
}

model Widget {
  id             String     @id @default(uuid())
  tenantId       String
  widgetType     WidgetType
  title          String
  subtitle       String?
  endpoint       String
  httpMethod     String     @default("GET")
  defaultParams  Json?
  config         Json       @default("{}")
  refreshSeconds Int?
  isActive       Boolean    @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  dashboards DashboardWidget[]
  roles      WidgetRole[]
  createdBy  User?             @relation("WidgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?             @relation("WidgetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("widgets")
}

model DashboardWidget {
  id          String  @id @default(uuid())
  dashboardId String
  widgetId    String
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  colSpan     Int     @default(6)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widget    Widget    @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, widgetId])
  @@index([dashboardId, isActive])
  @@map("dashboard_widgets")
}

model DashboardRole {
  dashboardId String
  roleId      String
  canView     Boolean @default(true)
  canEdit     Boolean @default(false)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([dashboardId, roleId])
  @@map("dashboard_roles")
}

model WidgetRole {
  widgetId String
  roleId   String

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([widgetId, roleId])
  @@map("widget_roles")
}

// ============= Tienda en línea (plantillas dinámicas) =============
// Un Template es reutilizable entre tenants (lo crea/edita plataforma); un
// TenantSite es la instancia de UN tenant sobre un Template — al asignarlo se
// clonan sus TemplateSection en TenantSiteSection, que es el contenido real y
// editable de ese tenant (independiente de otros tenants que usen el mismo
// Template). Feature gate: Tenant.enabledModules incluye SystemModule
// TIENDA_ONLINE ('tienda-online') — ver @orbix/types.

enum SiteSectionType {
  HERO
  VALUE_PROPS
  FEATURED_CATEGORIES
  FEATURED_PRODUCTS
  TESTIMONIALS
  CONTACT_FOOTER
}

// Template ya NO define su propia lista de secciones — es solo el registro
// de qué plantilla (código Astro fijo) tiene asignada un tenant. La
// composición de secciones de cada plantilla vive en código
// (DEFAULT_SITE_SECTIONS en platform-templates.service.ts) porque el HTML
// de cada plantilla también es fijo — solo se "llena" contenido, no se
// "crea" estructura.
model Template {
  id        String   @id @default(uuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantSites TenantSite[]

  @@map("templates")
}

// Una tienda en línea por tenant (home, por ahora) — 1:1, sin cambio de
// plantilla todavía (crear otro TenantSite para el mismo tenant no aplica).
model TenantSite {
  tenantId   String   @id
  templateId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template     Template            @relation(fields: [templateId], references: [id])
  siteSections TenantSiteSection[]

  @@map("tenant_sites")
}

model TenantSiteSection {
  id          String          @id @default(uuid())
  tenantId    String
  sectionType SiteSectionType
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  content     Json            @default("{}")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenantSite TenantSite @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)

  @@unique([tenantId, sortOrder])
  @@map("tenant_site_sections")
}

// ============= Store: pedidos por WhatsApp =============
// Sin pago en línea todavía: el carrito del storefront se registra aquí al
// enviarse por WhatsApp, y el administrador avanza el status a mano según lo
// que de verdad ocurre (ver StoreWhatsappOrdersService). El stock solo se
// descuenta y el pedido solo cuenta como ingreso al llegar a DELIVERED.
enum StoreWhatsappOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

model StoreWhatsappOrder {
  id          String                   @id @default(uuid())
  tenantId    String
  orderNumber String
  phone       String
  status      StoreWhatsappOrderStatus @default(PENDING)
  subtotal    Decimal                  @db.Decimal(10, 2)
  deliveredAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  StoreWhatsappOrderItem[]

  @@unique([tenantId, orderNumber])
  @@map("store_whatsapp_orders")
}

// Snapshot de cada línea al momento del pedido (nombre/precio propios, no una
// referencia viva a Product) — así el pedido no cambia si luego se edita o
// borra el producto.
model StoreWhatsappOrderItem {
  id        String   @id @default(uuid())
  orderId   String
  productId String?
  // Variante pedida. Ver OrderItem.variantId.
  variantId String?
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  order   StoreWhatsappOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant?    @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("store_whatsapp_order_items")
}

// ============= Auth =============

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  revokedAt DateTime @default(now())

  @@map("revoked_tokens")
}

// Opaque, rotating refresh tokens (mobile clients). The raw token is returned
// once to the client; only its SHA-256 hash is persisted. Access-token claims
// are rebuilt at refresh time from the user's lastTenantSelected/lastBranch,
// so the refresh token itself carries no tenant/branch context.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/// Ticket de un solo uso que cierra el redirect de OAuth. El callback de Google
/// redirige al frontend con el ticket en la URL —nunca con el JWT— y el
/// frontend lo canjea por la sesión real vía POST /auth/oauth/exchange.
/// Igual que los refresh tokens, solo se persiste el SHA-256: el valor crudo
/// viaja una vez y no queda recuperable desde la base.
model OAuthTicket {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("oauth_tickets")
}

/// Ticket de un solo uso que autoriza vincular una identidad de Google a UN
/// usuario ya autenticado, emitido desde Configuración → Mi cuenta antes de
/// mandar al navegador al redirect de Google.
///
/// Sin esto, "Vincular con Google" reutilizaría el mismo `resolveGoogleIdentity`
/// del login público — que resuelve por correo sin saber quién pedía vincular
/// — y si el correo de Google ya pertenece a OTRO usuario de Orbix, el callback
/// terminaría iniciando sesión como esa otra cuenta en vez de fallar con un
/// error. Este ticket amarra el callback al `userId` que realmente pidió
/// vincular, para poder rechazar ese choque en vez de ejecutarlo en silencio.
model GoogleLinkTicket {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("google_link_tickets")
}

/// Ticket de un solo uso que cierra el segundo paso del login cuando el
/// usuario tiene MFA activo: `login`/`exchangeOAuthTicket` verifican
/// contraseña o Google normalmente, pero en vez de emitir la sesión emiten
/// uno de estos — el frontend lo manda de vuelta junto con el código TOTP a
/// `POST /auth/mfa/verify`, que sí arma la sesión. TTL corto (5 min): es el
/// tiempo que tarda alguien en teclear un código de 6 dígitos, no una sesión.
model MfaChallengeTicket {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_challenge_tickets")
}

/// Códigos de un solo uso para cuando el usuario pierde el dispositivo con el
/// autenticador TOTP. Se generan 8 al activar MFA, se muestran una sola vez
/// (igual que un refresh token) y solo se guarda su SHA-256.
model MfaBackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_backup_codes")
}

// ============= Licensing (SaaS / POS / Mobile / on-prem) =============

enum LicenseStatus {
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum DeviceType {
  WEB
  POS_DESKTOP
  MOBILE_COMANDERA
  OTHER
}

enum DeviceStatus {
  ACTIVE
  REVOKED
  PENDING
}

// Authoritative licensing contract for a tenant. A tenant may accumulate a
// history of licenses; at most one is non-terminal (TRIAL/ACTIVE/SUSPENDED) and
// is considered "current". License mutations sync derived fields onto Tenant
// (plan, status, userLimitOverride, extraBranchLimit) so existing plan/limit
// logic keeps working. `expiresAt = null` means perpetual (e.g. on-prem).
model License {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  licenseKey  String        @unique @map("license_key")
  status      LicenseStatus @default(TRIAL)
  plan        TenantPlan    @default(FREE)
  startsAt    DateTime      @default(now()) @map("starts_at")
  expiresAt   DateTime?     @map("expires_at")
  maxUsers    Int?          @map("max_users")
  maxBranches Int?          @map("max_branches")
  maxDevices  Int?          @map("max_devices")
  notes       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([tenantId, status])
  @@map("licenses")
}

// A registered client (web session, POS desktop, mobile comandera, …). Bound to
// a tenant and (optionally) the license under which it was activated. Counts
// against License.maxDevices while ACTIVE.
model Device {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  branchId    String?      @map("branch_id")
  licenseId   String?      @map("license_id")
  deviceId    String       @map("device_id") // client-generated stable id / fingerprint
  // Durable device credential — the app's principal. Returned once on activate
  // and again on validate (keyed by deviceId). Revoked when status != ACTIVE.
  // Designed to also back future offline operation / local validation.
  deviceToken String?      @unique @map("device_token")
  name        String?
  model       String?
  os          String?
  appVersion  String?      @map("app_version")
  type        DeviceType   @default(OTHER)
  status      DeviceStatus @default(ACTIVE)
  lastSeenAt  DateTime?    @map("last_seen_at")
  activatedAt DateTime     @default(now()) @map("activated_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch  Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  license License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@unique([tenantId, deviceId])
  @@index([tenantId, status])
  @@map("devices")
}

// ============= Printer Configs =============

enum PrinterType {
  TICKET
  SALE_TICKET
  LABEL
  REPORT
}

enum PrinterConnection {
  USB
  NETWORK
  BLUETOOTH
  SYSTEM
}

model PrinterConfig {
  id               String            @id @default(uuid())
  tenantId         String
  branchId         String?
  name             String
  type             PrinterType       @default(TICKET)
  connectionType   PrinterConnection @default(NETWORK)
  ipAddress        String?
  port             Int?
  usbPath          String?
  bluetoothAddress String? // MAC address (00:11:22:33:44:55) o puerto RFCOMM (/dev/rfcomm0, COM3)
  systemName       String?
  paperWidth       Int?
  isDefault        Boolean           @default(false)
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([branchId])
  @@map("printer_configs")
}

// ============= AI Platform (usage) =============
// Fase 1 — AI Core (Orbix AI Platform, revisión 2). Ver ADR-0025..0027 y
// mcp-brain/vault (Decisions). Solo dos modelos en v1: el registro append-only
// de cada invocación y el contador agregado que respalda la verificación O(1)
// de límites. Sin tablas de routing ni de créditos comerciales — ver D-17.

enum AiUsageStatus {
  SUCCESS
  SCHEMA_REPAIRED
  OUTPUT_INVALID
  PROVIDER_ERROR
  TIMEOUT
  RATE_LIMITED
  QUOTA_EXCEEDED
  BUDGET_EXCEEDED
  CANCELLED
}

enum AiUsageOutcome {
  PENDING
  ACCEPTED
  EDITED
  DISCARDED
}

// Append-only. Una fila por intento (incluidos los fallidos — ver D-18: los
// fallos también se registran, si no la tasa de error es invisible).
// Particionado por mes: pendiente como trabajo operativo de infraestructura
// (native partitioning o pg_partman) cuando el volumen lo justifique; en v1
// los índices por (tenantId, createdAt) cubren las consultas de reporte y
// retención sin requerirlo.
model AiUsageEvent {
  id        String  @id @default(uuid())
  tenantId  String
  branchId  String?
  userId    String?
  requestId String  @unique

  featureKey    String
  promptVersion Int
  schemaVersion Int

  providerId    String
  modelKey      String
  attemptNumber Int      @default(1)
  degradations  String[] @default([])

  inputTokens  Int?
  outputTokens Int?
  totalTokens  Int?

  // Micro-USD (1 USD = 1_000_000). Nunca float — ver D-08 y §13 del documento
  // de arquitectura: es dato financiero, los errores de redondeo no son
  // aceptables en algo que algún día puede llegar a una factura.
  estimatedCostMicros BigInt @default(0)

  latencyMsTotal    Int?
  latencyMsProvider Int?

  status       AiUsageStatus
  errorCode    String?
  errorMessage String?        @db.VarChar(500)
  outcome      AiUsageOutcome @default(PENDING)

  createdAt DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user   User?   @relation("AiUsageEventUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, featureKey, createdAt])
  @@index([status])
  @@map("ai_usage_events")
}

// Contador agregado por (tenant, periodo, feature). Existe únicamente para que
// la verificación de límite sea O(1) en la ruta síncrona del gateway — no
// requiere escanear ai_usage_events. Se incrementa en la misma transacción
// que se escribe el evento (ver AiUsageRecorder).
model AiUsageCounter {
  id         String @id @default(uuid())
  tenantId   String
  // Formato 'YYYY-MM', mes calendario en UTC.
  period     String
  featureKey String

  invocationCount     Int    @default(0)
  successCount        Int    @default(0)
  totalTokens         Int    @default(0)
  estimatedCostMicros BigInt @default(0)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period, featureKey])
  @@map("ai_usage_counters")
}

/// Invitación para que una persona se una a una empresa.
///
/// Dar acceso a alguien no puede ser una decisión unilateral del administrador:
/// la persona acepta desde su correo. Eso resuelve dos cosas a la vez — nadie
/// entra a una empresa sin saberlo, y nadie fija la contraseña de otro.
///
/// El token solo se guarda hasheado (SHA-256), igual que `RefreshToken` y
/// `OAuthTicket`: si la base se filtra, los enlaces pendientes no son usables.
model TenantInvitation {
  id       String @id @default(uuid())
  tenantId String
  /// Correo invitado. Puede tener cuenta en la plataforma o no; el flujo de
  /// aceptación se adapta a cada caso.
  email    String

  tokenHash String @unique @map("token_hash")

  /// Roles que se asignarán al aceptar. Se validan al invitar (que sean del
  /// tenant y que el invitador los posea) y otra vez al aceptar.
  roleIds String[] @default([]) @map("role_ids")

  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([tenantId, email])
  @@index([email])
  @@map("tenant_invitations")
}

/// Reseteo de contraseña por correo, para una cuenta que ya existe.
///
/// Vida corta (1h) frente a las 72h de `TenantInvitation`: aquí ya hay una
/// cuenta y credenciales potencialmente comprometidas en juego, así que la
/// ventana de uso del enlace se mantiene mínima. Igual que las demás
/// credenciales de un solo uso del sistema, solo se guarda el hash SHA-256.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
