// ============= Services =============

model Service {
  id                String  @id @default(uuid())
  tenantId          String
  name              String
  description       String?
  basePrice         Decimal @db.Decimal(10, 2)
  estimatedDuration String?
  hasVariablePrice  Boolean @default(false)
  isActive          Boolean @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy  User?              @relation("ServiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy  User?              @relation("ServiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  quoteItems ServiceQuoteItem[]
  orderItems OrderItem[]
  workOrders WorkOrder[]

  @@map("services")
}

// ============= Service Quotes =============

enum ServiceQuoteStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
}

model ServiceQuote {
  id                    String             @id @default(uuid())
  tenantId              String
  customerId            String
  quoteNumber           String
