generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// ============= Tenants =============

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  CANCELLED
  EXPIRED
  DISABLED
}

// ============= Platform (SaaS Admin) =============

enum PlatformUserRole {
  SUPER_ADMIN
  SUPPORT
}

enum PlatformUserStatus {
  ACTIVE
  INACTIVE
}

model PlatformUser {
  id        String             @id @default(uuid())
  email     String             @unique
  password  String
  firstName String
  lastName  String
  role      PlatformUserRole   @default(SUPER_ADMIN)
  status    PlatformUserStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_users")
}

model PlatformAuditLog {
  id             String   @id @default(uuid())
  platformUserId String?
  tenantId       String?
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  notes          String?
  createdAt      DateTime @default(now())

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, action])
  @@index([platformUserId, createdAt])
  @@map("platform_audit_logs")
}

enum TenantPlan {
  FREE
  STARTER
  PRO
  PLUS
  ENTERPRISE
}

enum BusinessVertical {
  RETAIL
  RESTAURANT
  GYM
  SERVICES
}

// Base architecture of the tenant, fixed at provisioning time and NOT editable
// from the ERP. Distinct from BusinessVertical (operational behaviour): the
// profile describes the structural shape the tenant was created with. Pure
// persistence for now — no behaviour is derived from it yet (BP-01).
enum BusinessProfile {
  RETAIL
  RETAIL_MANUFACTURING
  RESTAURANT
  MANUFACTURING
  SERVICES
  WORKSHOP
}

enum PosOperationMode {
  QUICK_SALE
  TABLE_SERVICE
}

enum TenantFeature {
  TABLES
  KITCHEN
  DELIVERY
  MEMBERSHIPS
  ACCESS_CONTROL
  SERVICES
  APPOINTMENTS
}

enum TenantRole {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

// Per-tenant access state. Decoupled from the global User.status so that
// disabling a user in one tenant never affects their access elsewhere and
// historical records/audit are always preserved (no physical deletion).
enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique // subdomain / identifier
  status                TenantStatus          @default(TRIAL)
  plan                  TenantPlan            @default(FREE)
  enabledModules        String[]              @default([])
  businessVertical      BusinessVertical      @default(RETAIL) @map("business_vertical")
  businessProfile       BusinessProfile       @default(RETAIL) @map("business_profile")
  posOperationMode      PosOperationMode      @default(QUICK_SALE) @map("pos_operation_mode")
  restaurantServiceMode RestaurantServiceMode @default(TABLE_SERVICE) @map("restaurant_service_mode")
  enabledFeatures       TenantFeature[]       @default([]) @map("enabled_features")
  settings              Json? // { currency, timezone, logo, address, taxId, ... }

  // ── SaaS user-limit control ────────────────────────────────────────────────
  // overUserLimit is set on downgrade when active users exceed the new plan
  // limit. Soft enforcement: tenant keeps operating but cannot add/activate
  // more users until back under the limit. No automatic deactivation.
  overUserLimit            Boolean @default(false) @map("over_user_limit")
  // Manual cap that overrides the plan default for ANY plan (e.g. ENTERPRISE).
  userLimitOverride        Int?    @map("user_limit_override")
  // Extra branches added on top of the plan default (addons, upgrades, etc.)
  extraBranchLimit         Int?    @default(0) @map("extra_branch_limit")
  // Cash sessions open at once per branch. Absolute override of the plan
  // default (not additive), set from the platform panel.
  cashSessionLimitOverride Int?    @map("cash_session_limit_override")
  // Protected owner — cannot be deactivated.
  ownerUserId              String? @map("owner_user_id")

  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  memberships        TenantMembership[]
  invitations        TenantInvitation[]
  customers          Customer[]
  categories         Category[]
  products           Product[]
  coupons            Coupon[]
  orders             Order[]
  orderRefunds       OrderRefund[]
  roles              Role[]
  branches           Branch[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  accountReceivables AccountReceivable[]
  accountsPayable    AccountPayable[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  cashCounts         CashCount[]
  cashRegisters      CashRegister[]
  services           Service[]
  serviceQuotes      ServiceQuote[]
  workOrders         WorkOrder[]
  auditLogs          AuditLog[]
  supplies           Supply[]
  supplyMovements    SupplyMovement[]
  printerConfigs     PrinterConfig[]

  usersLastSelected User[]            @relation("UserLastTenant")
  employees         Employee[]
  diningAreas       DiningArea[]
  restaurantTables  RestaurantTable[]
  diningOrders      DiningOrder[]
  dashboards        Dashboard[]
  widgets           Widget[]

  licenses License[]
  devices  Device[]

  owner User? @relation("TenantOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  domains             Domain[]
  site                TenantSite?
  storeWhatsappOrders StoreWhatsappOrder[]

  aiUsageEvents   AiUsageEvent[]
  aiUsageCounters AiUsageCounter[]

  @@map("tenants")
}

// Maps a public hostname (custom domain or dev origin, e.g. "manzanitas.mx",
// "localhost:4321") to a tenant. Used to resolve which tenant an unauthenticated
// storefront request belongs to, based on the request's Origin header — the
// e-commerce codebase itself never needs to know its own tenantId.
model Domain {
  id        String   @id @default(uuid())
  tenantId  String
  hostname  String   @unique
  verified  Boolean  @default(false)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("domains")
}

model TenantMembership {
  tenantId   String
  userId     String
  role       TenantRole       @default(STAFF)
  status     MembershipStatus @default(ACTIVE)
  assignedAt DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId])
  @@map("tenant_memberships")
}

// ============= Admin Users =============
enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  // Null para cuentas creadas por un proveedor OAuth: ese usuario no tiene
  // contraseña local y solo puede entrar por su proveedor hasta que fije una.
  password  String?
  firstName String
  lastName  String
  role      UserRole   @default(STAFF)
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // ── Identidad Google (OAuth) ───────────────────────────────────────────────
  googleId      String? @unique @map("google_id")
  emailVerified Boolean @default(false) @map("email_verified")
  avatarUrl     String? @map("avatar_url")

  // ── Protección contra fuerza bruta ─────────────────────────────────────────
  // El throttling por IP no frena un ataque lento y distribuido contra una
  // cuenta concreta. Estos dos campos acotan los intentos por CUENTA: el
  // contador se reinicia al entrar bien, y `lockedUntil` marca hasta cuándo se
  // rechaza el acceso aunque la contraseña sea correcta.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")

  // H-06: el access token no tenía forma de invalidarse antes de su propio
  // `exp` — cambiar la contraseña solo revocaba refresh tokens
  // (`RefreshTokenService.revokeAllForUser`), así que un access token ya
  // emitido seguía sirviendo hasta 24h después de que su dueño perdiera el
  // control de la cuenta. `JwtStrategy` rechaza cualquier token con
  // `iat` anterior a esta marca.
  tokensValidFrom DateTime? @map("tokens_valid_from")

  // ── MFA (TOTP, opcional por usuario) ───────────────────────────────────────
  // El secreto va cifrado (AES-256-GCM, ver MfaService) porque a diferencia de
  // una contraseña no se puede hashear: hay que poder leerlo de vuelta para
  // calcular el código esperado en cada verificación.
  mfaEnabled   Boolean @default(false) @map("mfa_enabled")
  mfaSecretEnc String? @map("mfa_secret_enc")

  mfaBackupCodes      MfaBackupCode[]
  mfaChallengeTickets MfaChallengeTicket[]

  tenantMemberships TenantMembership[]

  // Auditoría
  customersCreated  Customer[] @relation("CustomerCreatedBy")
  customersUpdated  Customer[] @relation("CustomerUpdatedBy")
  categoriesCreated Category[] @relation("CategoryCreatedBy")
  categoriesUpdated Category[] @relation("CategoryUpdatedBy")
  productsCreated   Product[]  @relation("ProductCreatedBy")
  productsUpdated   Product[]  @relation("ProductUpdatedBy")
  ordersCreated     Order[]    @relation("OrderCreatedBy")
  ordersUpdated     Order[]    @relation("OrderUpdatedBy")
  couponsCreated    Coupon[]   @relation("CouponCreatedBy")
  couponsUpdated    Coupon[]   @relation("CouponUpdatedBy")

  suppliersCreated Supplier[] @relation("SupplierCreatedBy")
  suppliersUpdated Supplier[] @relation("SupplierUpdatedBy")

  purchaseOrdersCreated     PurchaseOrder[]       @relation("POCreatedBy")
  purchaseOrdersUpdated     PurchaseOrder[]       @relation("POUpdatedBy")
  purchaseReceiptsReceived  PurchaseReceipt[]     @relation("ReceiptReceivedBy")
  inventoryMovementsCreated InventoryMovement[]   @relation("MovementCreatedBy")
  supplierPaymentsCreated   SupplierPayment[]     @relation("SupplierPaymentCreatedBy")
  cashMovementsCreated      CashMovement[]        @relation("CashMovementCreatedBy")
  cashSessionsOpened        CashSession[]         @relation("CashSessionOpenedBy")
  cashSessionsClosed        CashSession[]         @relation("CashSessionClosedBy")
  cashSessionsAuthorized    CashSession[]         @relation("CashSessionAuthorizedBy")
  cashCountsCounted         CashCount[]           @relation("CashCountCountedBy")
  cashCountsAuthorized      CashCount[]           @relation("CashCountAuthorizedBy")
  servicesCreated           Service[]             @relation("ServiceCreatedBy")
  servicesUpdated           Service[]             @relation("ServiceUpdatedBy")
  serviceQuotesCreated      ServiceQuote[]        @relation("ServiceQuoteCreatedBy")
  ordersCancelled           Order[]               @relation("OrderCancelledBy")
  paymentsCreated           Payment[]             @relation("PaymentCreatedBy")
  refundsCreated            OrderRefund[]         @relation("RefundCreatedBy")
  auditLogs                 AuditLog[]            @relation("AuditLogUser")
  workOrdersCreated         WorkOrder[]           @relation("WorkOrderCreatedBy")
  workOrderAssignments      WorkOrderAssignment[] @relation("WorkOrderAssignments")
  employeeProfiles          Employee[]            @relation("EmployeeAccount")
  employeesCreated          Employee[]            @relation("EmployeeCreatedBy")
  employeesUpdated          Employee[]            @relation("EmployeeUpdatedBy")
  diningAreasCreated        DiningArea[]          @relation("DiningAreaCreatedBy")
  diningAreasUpdated        DiningArea[]          @relation("DiningAreaUpdatedBy")
  restaurantTablesCreated   RestaurantTable[]     @relation("RestaurantTableCreatedBy")
  restaurantTablesUpdated   RestaurantTable[]     @relation("RestaurantTableUpdatedBy")
  dashboardsCreated         Dashboard[]           @relation("DashboardCreatedBy")
  dashboardsUpdated         Dashboard[]           @relation("DashboardUpdatedBy")
  widgetsCreated            Widget[]              @relation("WidgetCreatedBy")
  widgetsUpdated            Widget[]              @relation("WidgetUpdatedBy")
  suppliesCreated           Supply[]              @relation("SupplyCreatedBy")
  suppliesUpdated           Supply[]              @relation("SupplyUpdatedBy")
  supplyMovementsCreated    SupplyMovement[]      @relation("SupplyMovementCreatedBy")

  roleAssignments  UserRoleAssignment[]
  permissionGrants UserPermissionGrant[]

  refreshTokens       RefreshToken[]
  oauthTickets        OAuthTicket[]
  googleLinkTickets   GoogleLinkTicket[]
  invitationsSent     TenantInvitation[]   @relation("InvitationInvitedBy")
  passwordResetTokens PasswordResetToken[]

  managedBranches   Branch[]           @relation("BranchManager")
  branchMemberships BranchMembership[]

  lastTenantSelectedId String? @map("last_tenant_selected_id")
  lastBranchSelectedId String? @map("last_branch_selected_id")

  lastTenantSelected Tenant? @relation("UserLastTenant", fields: [lastTenantSelectedId], references: [id], onDelete: SetNull)
  lastBranchSelected Branch? @relation("UserLastBranch", fields: [lastBranchSelectedId], references: [id], onDelete: SetNull)

  tenantsOwned Tenant[] @relation("TenantOwner")

  aiUsageEvents AiUsageEvent[] @relation("AiUsageEventUser")

  @@map("users")
}

// ============= Customers =============
enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerType {
  NEW
  REGULAR
  VIP
  WHOLESALE
}

model Customer {
  id        String         @id @default(uuid())
  tenantId  String
  email     String
  firstName String
  lastName  String
  phone     String?
  company   String?
  city      String?
  legalName String?        @map("legal_name")
  status    CustomerStatus @default(ACTIVE)

  type        CustomerType @default(NEW)
  totalOrders Int          @default(0)
  totalSpent  Decimal      @default(0) @db.Decimal(10, 2)

  hasCredit   Boolean  @default(false)
  creditLimit Decimal? @db.Decimal(10, 2)
  creditDays  Int      @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  addresses          CustomerAddress[]
  orders             Order[]
  accountReceivables AccountReceivable[]
  serviceQuotes      ServiceQuote[]
  workOrders         WorkOrder[]
  createdBy          User?               @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  label      String
  firstName  String
  lastName   String
  phone      String
  address1   String
  address2   String?
  city       String
  state      String
  zipCode    String
  country    String   @default("US")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders   Order[]

  @@map("customer_addresses")
}

// ============= Suppliers =============
enum SupplierStatus {
  ACTIVE
  INACTIVE
}

model Supplier {
  id           String         @id @default(uuid())
  tenantId     String
  name         String
  contactName  String?
  email        String
  phone        String?
  city         String?
  category     String?
  paymentTerms String?
  status       SupplierStatus @default(ACTIVE)
  totalOrders  Int            @default(0)
  totalSpent   Decimal        @default(0) @db.Decimal(12, 2)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy       User?            @relation("SupplierCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy       User?            @relation("SupplierUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  purchaseOrders  PurchaseOrder[]
  accountsPayable AccountPayable[]

  @@unique([tenantId, email])
  @@map("suppliers")
}

// ============= Purchases =============

enum PurchaseOrderStatus {
  BORRADOR
  ENVIADA
  PARCIAL
  COMPLETADA
  CANCELADA
}

enum InventoryMovementType {
  COMPRA
  VENTA
  AJUSTE
  TRANSFERENCIA
  DEVOLUCION
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenantId     String
  orderNumber  String
  supplierId   String
  branchId     String?
  status       PurchaseOrderStatus @default(BORRADOR)
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  subtotal     Decimal             @db.Decimal(10, 2)
  tax          Decimal             @default(0) @db.Decimal(10, 2)
  total        Decimal             @db.Decimal(10, 2)
  notes        String?

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  branch         Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items          PurchaseOrderItem[]
  receipts       PurchaseReceipt[]
  accountPayable AccountPayable?
  createdBy      User?               @relation("POCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User?               @relation("POUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, orderNumber])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  productId       String
  // Variante que se compra. Ver OrderItem.variantId.
  variantId       String?
  quantityOrdered Int
  unitCost        Decimal @db.Decimal(10, 2)
  tax             Decimal @default(0) @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("purchase_order_items")
}

model PurchaseReceipt {
  id              String   @id @default(uuid())
  purchaseOrderId String
  receivedById    String?
  receivedDate    DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
  receivedBy    User?                 @relation("ReceiptReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  items         PurchaseReceiptItem[]

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                String  @id @default(uuid())
  purchaseReceiptId String
  productId         String
  // Variante que se recibe. Ver OrderItem.variantId.
  variantId         String?
  quantityReceived  Int

  receipt PurchaseReceipt @relation(fields: [purchaseReceiptId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("purchase_receipt_items")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  tenantId      String
  type          InventoryMovementType
  productId     String
  // Variante contra la que se movió la existencia. Ver OrderItem.variantId.
  variantId     String?
  branchId      String?
  quantity      Int
  referenceId   String?
  referenceType String?
  notes         String?
  createdById   String?
  createdAt     DateTime              @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?           @relation("MovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("inventory_movements")
}

// ============= Categories =============
enum CategoryStatus {
  ACTIVE
  INACTIVE
}

model Category {
  id          String         @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  parentId    String?
  status      CategoryStatus @default(ACTIVE)
  sortOrder   Int            @default(0)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Category?       @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[]      @relation("CategoryToCategory")
  products  Product[]
  coupons   Coupon[]
  images    CategoryImage[]
  createdBy User?           @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?           @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@map("categories")
}

// Foto de referencia de la categoría — misma estructura que ProductImage
// (un solo registro "primary" a la vez; upload reemplaza el anterior).
model CategoryImage {
  id         String   @id @default(uuid())
  categoryId String
  url        String
  key        String?
  mimeType   String?  @map("mime_type")
  size       Int?
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("category_images")
}

// ============= Products =============
enum ProductType {
  SIMPLE
  RECIPE
  COMBO
  SERVICE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TaxCode {
  IVA_16
  IVA_11
  IVA_8
  EXCENTO
}

model Product {
  id              String        @id @default(uuid())
  tenantId        String
  sku             String
  name            String
  slug            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  taxRate         Decimal?      @db.Decimal(10, 2)
  taxCode         TaxCode?      @default(IVA_16)
  comparePrice    Decimal?      @db.Decimal(10, 2)
  costPrice       Decimal?      @db.Decimal(10, 2)
  type            ProductType   @default(SIMPLE)
  categoryId      String?
  status          ProductStatus @default(DRAFT)
  stock           Int           @default(0)
  trackInventory  Boolean       @default(true)
  lowStockAlert   Int           @default(5)
  metaTitle       String?
  metaDescription String?
  lastCost        Decimal?      @db.Decimal(10, 2)
  avgCost         Decimal?      @db.Decimal(10, 2)
  // Gates visibility on the public storefront (see StoreService) and whether
  // the admin product form asks for attribute values (size/color/type/...).
  isEcommerce     Boolean       @default(false)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category                Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images                  ProductImage[]
  orderItems              OrderItem[]
  coupons                 Coupon[]
  branchInventory         BranchInventory[]
  purchaseOrderItems      PurchaseOrderItem[]
  purchaseReceiptItems    PurchaseReceiptItem[]
  inventoryMovements      InventoryMovement[]
  quoteItems              ServiceQuoteItem[]
  recipe                  Recipe?
  comboItems              ComboItem[]              @relation("ComboItems")
  inCombos                ComboItem[]              @relation("ComboChildItems")
  variants                ProductVariant[]
  features                ProductFeature[]
  storeWhatsappOrderItems StoreWhatsappOrderItem[]
  createdBy               User?                    @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?                    @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  key       String?
  mimeType  String?  @map("mime_type")
  size      Int?
  altText   String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// ============= Product Variants =============
// Per-product line (variant/modifier): always owned by exactly one Product.
// Not a reusable cross-product catalog.
//
// Every Product has exactly one variant with `isDefault = true`, whose `name`
// is null — it is the implicit "the product itself" line, and it is what carries
// the stock of products that were never split into named variants. A partial
// unique index (see the add_variant_inventory migration) enforces the "exactly
// one default per product" invariant at the DB level.
//
// Stock/cost/price live on BranchInventory keyed by [branchId, variantId] —
// `cost`/`price` here are legacy columns kept during the expand phase of the
// migration and are no longer the source of truth.
model ProductVariant {
  id             String  @id @default(uuid())
  productId      String
  name           String?
  /// Código de la presentación. ADR-0030 pone `sku` y `barcode` en la variante
  /// porque es la unidad vendible: una talla M y una L son artículos distintos
  /// al etiquetar, recibir y contar.
  ///
  /// Opcional y ADITIVO: `Product.sku` sigue existiendo como código padre, así
  /// que nada de lo que ya lo usa se rompe. Vacío aquí, manda el del producto.
  sku            String?
  /// Código de barras de esta presentación. Mismo criterio que `sku`.
  barcode        String?
  isDefault      Boolean @default(false)
  // Policy flag: does this variant carry inventory at all? Per-variant rather
  // than per-branch (unlike lowStockAlert, a genuinely branch-level reorder
  // point). Mirrors the legacy Product.trackInventory, kept in sync during expand.
  trackInventory Boolean @default(true)
  cost           Decimal @default(0) @db.Decimal(10, 2)
  price          Decimal @default(0) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product                 Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchInventory         BranchInventory[]
  orderItems              OrderItem[]
  inventoryMovements      InventoryMovement[]
  purchaseOrderItems      PurchaseOrderItem[]
  purchaseReceiptItems    PurchaseReceiptItem[]
  storeWhatsappOrderItems StoreWhatsappOrderItem[]

  /// Para resolver un escaneo, no para restringir: la unicidad es POR EMPRESA y
  /// el tenant vive en el producto, así que no cabe en un índice de esta tabla.
  /// La impone `ProductsService`.
  @@index([sku])
  @@index([barcode])
  @@map("product_variants")
}

// ============= Product Features (specs) =============
// Free-form key/value spec sheet for a product (e.g. "Material" → "Algodón").
// Always owned by exactly one Product. Purely descriptive — no cost/price,
// unlike ProductVariant (which models priced variants).
model ProductFeature {
  id        String @id @default(uuid())
  productId String
  feature   String
  value     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_features")
}

// ============= Measurement Units =============
enum UnitCategory {
  WEIGHT
  VOLUME
  COUNT
}

model MeasurementUnit {
  id         String       @id @default(uuid())
  name       String
  symbol     String       @unique
  category   UnitCategory
  baseFactor Decimal      @default(1) @db.Decimal(15, 6)
  isBase     Boolean      @default(false)
  isSystem   Boolean      @default(true)

  baseSupplies      Supply[]            @relation("SupplyBaseUnit")
  inventorySupplies Supply[]            @relation("SupplyInventoryUnit")
  allowedInSupplies SupplyAllowedUnit[]
  recipeItems       RecipeItem[]

  @@map("measurement_units")
}

model SupplyAllowedUnit {
  id               String  @id @default(uuid())
  supplyId         String
  unitId           String
  conversionFactor Decimal @default(1) @db.Decimal(15, 6)

  supply Supply          @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  unit   MeasurementUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([supplyId, unitId])
  @@map("supply_allowed_units")
}

// ============= Supplies (Insumos/Ingredientes) =============
enum SupplyStatus {
  ACTIVE
  INACTIVE
}

enum SupplyMovementType {
  PURCHASE
  RECIPE_CONSUMPTION
  ADJUSTMENT
}

model Supply {
  id               String       @id @default(uuid())
  tenantId         String
  name             String
  sku              String
  unit             String
  purchaseUnit     String?      @map("purchase_unit")
  stock            Decimal      @default(0) @db.Decimal(15, 6)
  minStock         Decimal      @default(0) @db.Decimal(15, 6)
  cost             Decimal      @default(0) @db.Decimal(10, 2)
  baseUnitId       String?
  inventoryUnitId  String?
  conversionFactor Decimal      @default(1) @db.Decimal(15, 6)
  branchId         String?
  status           SupplyStatus @default(ACTIVE)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  baseUnit      MeasurementUnit?    @relation("SupplyBaseUnit", fields: [baseUnitId], references: [id], onDelete: SetNull)
  inventoryUnit MeasurementUnit?    @relation("SupplyInventoryUnit", fields: [inventoryUnitId], references: [id], onDelete: SetNull)
  allowedUnits  SupplyAllowedUnit[]
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?             @relation("BranchSupplies", fields: [branchId], references: [id], onDelete: SetNull)
  recipeItems   RecipeItem[]
  movements     SupplyMovement[]
  createdBy     User?               @relation("SupplyCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy     User?               @relation("SupplyUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, sku])
  @@map("supplies")
}

model SupplyMovement {
  id          String             @id @default(uuid())
  tenantId    String
  supplyId    String
  type        SupplyMovementType
  quantity    Decimal            @db.Decimal(10, 3)
  branchId    String?
  referenceId String?
  notes       String?
  createdById String?
  createdAt   DateTime           @default(now())

  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supply    Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  branch    Branch? @relation("BranchSupplyMovements", fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("SupplyMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("supply_movements")
}

// ============= Recipes & Combos =============
model Recipe {
  id        String   @id @default(uuid())
  productId String   @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  items   RecipeItem[]

  @@map("recipes")
}

model RecipeItem {
  id                 String   @id @default(uuid())
  recipeId           String
  supplyId           String
  quantity           Decimal  @db.Decimal(10, 3)
  unit               String
  unitId             String?
  normalizedQuantity Decimal? @db.Decimal(15, 6)

  recipe          Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  supply          Supply           @relation(fields: [supplyId], references: [id])
  measurementUnit MeasurementUnit? @relation(fields: [unitId], references: [id], onDelete: SetNull)

  @@map("recipe_items")
}

model ComboItem {
  id             String @id @default(uuid())
  comboProductId String
  childProductId String
  quantity       Int    @default(1)

  combo Product @relation("ComboItems", fields: [comboProductId], references: [id], onDelete: Cascade)
  child Product @relation("ComboChildItems", fields: [childProductId], references: [id])

  @@map("combo_items")
}

// ============= Coupons =============
enum CouponType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  GLOBAL
  PRODUCT
  CATEGORY
}

model Coupon {
  id          String      @id @default(uuid())
  tenantId    String
  code        String
  description String?
  type        CouponType
  value       Decimal     @db.Decimal(10, 2)
  scope       CouponScope

  productId  String?
  categoryId String?

  autoApply           Boolean        @default(false)
  customerTypes       CustomerType[]
  isFirstPurchaseOnly Boolean        @default(false)
  minOrders           Int?

  minPurchase           Decimal? @db.Decimal(10, 2)
  maxDiscount           Decimal? @db.Decimal(10, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usageCount            Int      @default(0)

  startDate DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)

  createdById String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy User?     @relation("CouponCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?     @relation("CouponUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
