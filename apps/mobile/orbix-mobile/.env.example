# Copy to `.env` (local overrides, git-ignored). Expo inlines every EXPO_PUBLIC_*
# variable into the JS bundle at build time — never put a secret here.

# Base URL of the Orbix NestJS API, including the `/api` global prefix.
#
# Las apps móviles se conectan al puerto 3002, que es el proxy
# (`scripts/proxy.js` en la raíz del monorepo) hacia la API en :3001. El proxy
# añade `Access-Control-Allow-Origin: *` y da una URL estable para el
# dispositivo. Arráncalo con `node scripts/proxy.js`.
#
# Desde un teléfono físico usa la IP LAN de tu máquina, no `localhost`:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3002/api
EXPO_PUBLIC_API_URL=http://localhost:3002/api

# Request timeout in milliseconds.
EXPO_PUBLIC_API_TIMEOUT=15000

# Google OAuth client IDs (expo-auth-session). Leave empty to disable the
# "Continue with Google" button — the app degrades gracefully.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Default language when the device locale is not supported (es | en | pt).
EXPO_PUBLIC_DEFAULT_LOCALE=es
